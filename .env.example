# === Admin Credentials ===
ADMIN_USER=admin
ADMIN_PASSWORD=diamond123
# A secret used to sign admin session cookies
ADMIN_SECRET=change-this-to-a-long-random-string

# === Stripe Payment Settings ===
# Get your keys from https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_...) for development, LIVE keys (sk_live_...) for production.
# Test mode uses fake card numbers (e.g. 4242 4242 4242 4242) and does not charge real money.
STRIPE_SECRET_KEY=
# Optional: your publishable key (sk_... / pk_...). Not strictly required for server-side checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === SMTP / Email Settings (for confirmation emails) ===
# When a booking is confirmed in the admin dashboard, an email is sent to the
# customer using these settings. Leave blank to disable email sending.
#
# Example using Gmail (enable "App Passwords" in your Google account):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=Diamond Cleaning Services
#
# Example using a hosting provider / Office365 / other SMTP:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=no-reply@yourdomain.com
#   SMTP_PASS=your-smtp-password
#   SMTP_FROM=Diamond Cleaning Services

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Diamond Cleaning Services

# Copy this file to .env.local and fill in your real values.
